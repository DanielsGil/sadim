# SADIM — variables de entorno de ejemplo
# NOTA: backend/core/settings.py todavia NO lee estas variables (SECRET_KEY,
# DEBUG y la base de datos estan hardcodeados). Este archivo deja el contrato
# esperado para cuando se conecte settings.py a variables de entorno
# (pendiente, ver auditoria Sprint 2 - IMP-09 SQLite en vez de PostgreSQL).

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL, ADR-001) — no usadas todavia por settings.py
DB_NAME=sadim
DB_USER=sadim
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
